    "abstract": "A throwaway submission used to exercise the paper layer end to end: two\ntrivial concepts, two trivial proofs, and a small LaTeX paper whose\npassages are marked with `% lax` comments.\n"
  },
  "requiredByConcepts": [],
  "requiredByProofs": [],
  "concepts": [
    {
      "id": "Lax61.One",
      "path": "concepts/Lax61/One.lean",
      "title": "One equals one",
      "type": "theorem",
      "description": "The other trivial claim, that one equals itself.",
      "imports": [],
      "mathlibImports": [],
      "sourceText": "/-!\n---\ntitle: One equals one\ntype: theorem\n---\nThe other trivial claim, that one equals itself.\n-/\n\nnamespace Lax61.One\n\n/-- one equals one -/\naxiom oneEq : 1 = 1\n\nend Lax61.One\n",
      "statements": [
        {
          "id": "Lax61.One.oneEq",
          "signature": "oneEq : Eq 1 1",
          "startLine": 11,
          "endLine": 12,
          "doc": "one equals one"
        }
      ]
    },
    {
      "id": "Lax61.Zero",
      "path": "concepts/Lax61/Zero.lean",
      "title": "Zero equals zero",
      "type": "theorem",
      "description": "The trivial claim that zero equals itself.",
      "imports": [],
      "mathlibImports": [],
      "sourceText": "/-!\n---\ntitle: Zero equals zero\ntype: theorem\n---\nThe trivial claim that zero equals itself.\n-/\n\nnamespace Lax61.Zero\n\n/-- zero equals zero -/\naxiom zeroEq : 0 = 0\n\nend Lax61.Zero\n",
      "statements": [
        {
          "id": "Lax61.Zero.zeroEq",
          "signature": "zeroEq : Eq 0 0",
          "startLine": 11,
          "endLine": 12,
          "doc": "zero equals zero"
        }
      ]
    }
  ],
