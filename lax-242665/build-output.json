  "concepts": [
    {
      "id": "Lax242665.BertrandPostulate",
      "path": "concepts/Lax242665/BertrandPostulate.lean",
      "title": "Bertrand's postulate",
      "type": "lemma",
      "description": "For every natural number $n \\geq 1$ there is a prime number $p$ with\n$n < p \\leq 2n$.",
      "imports": [
        "Lax242665.Primes"
      ],
      "mathlibImports": [],
      "sourceText": "import Lax242665.Primes\n\n/-!\n---\ntitle: Bertrand's postulate\ntype: lemma\n---\nFor every natural number $n \\geq 1$ there is a prime number $p$ with\n$n < p \\leq 2n$.\n-/\n\nnamespace Lax242665.BertrandPostulate\n\n/-- For every `n ≥ 1` there is a prime `p` with `n < p ≤ 2n`. -/\naxiom exists_prime_between :\n    ∀ n : ℕ, 1 ≤ n → ∃ p : ℕ, Primes.Prime p ∧ n < p ∧ p ≤ 2 * n\n\nend Lax242665.BertrandPostulate\n",
      "statements": [
        {
          "id": "Lax242665.BertrandPostulate.exists_prime_between",
          "signature": "exists_prime_between : ∀ (n : Nat),\n  instLENat.le 1 n →\n    Exists fun p => And (Lax242665.Primes.Prime p) (And (instLTNat.lt n p) (instLENat.le p (instHMul.hMul 2 n)))",
          "startLine": 14,
          "endLine": 16,
          "doc": "For every `n ≥ 1` there is a prime `p` with `n < p ≤ 2n`."
        }
      ]
    },
    {
      "id": "Lax242665.InfinitelyManyPrimes",
      "path": "concepts/Lax242665/InfinitelyManyPrimes.lean",
      "title": "There are infinitely many primes",
      "type": "theorem",
      "description": "For every natural number $n$ there is a prime number $p > n$.",
      "imports": [
        "Lax242665.Primes"
      ],
      "mathlibImports": [],
      "sourceText": "import Lax242665.Primes\n\n/-!\n---\ntitle: There are infinitely many primes\ntype: theorem\n---\nFor every natural number $n$ there is a prime number $p > n$.\n-/\n\nnamespace Lax242665.InfinitelyManyPrimes\n\n/-- Beyond every natural number `n` lies a prime `p`. -/\naxiom exists_prime_gt : ∀ n : ℕ, ∃ p : ℕ, Primes.Prime p ∧ n < p\n\nend Lax242665.InfinitelyManyPrimes\n",
      "statements": [
        {
          "id": "Lax242665.InfinitelyManyPrimes.exists_prime_gt",
          "signature": "exists_prime_gt : ∀ (n : Nat), Exists fun p => And (Lax242665.Primes.Prime p) (instLTNat.lt n p)",
          "startLine": 13,
          "endLine": 14,
          "doc": "Beyond every natural number `n` lies a prime `p`."
        }
      ]
    },
    {
      "id": "Lax242665.OddPrimeBetween",
      "path": "concepts/Lax242665/OddPrimeBetween.lean",
      "title": "An odd prime between n and 2n",
      "type": "theorem",
      "description": "For every natural number $n \\geq 2$ there is an odd prime number $p$ with\n$n < p \\leq 2n$.",
      "imports": [
        "Lax242665.Primes"
      ],
      "mathlibImports": [
        "Mathlib.Algebra.Ring.Parity"
      ],
      "sourceText": "import Mathlib.Algebra.Ring.Parity\nimport Lax242665.Primes\n\n/-!\n---\ntitle: An odd prime between n and 2n\ntype: theorem\n---\nFor every natural number $n \\geq 2$ there is an odd prime number $p$ with\n$n < p \\leq 2n$.\n-/\n\nnamespace Lax242665.OddPrimeBetween\n\n/-- For every `n ≥ 2` there is an odd prime `p` with `n < p ≤ 2n`. -/\naxiom exists_odd_prime_between :\n    ∀ n : ℕ, 2 ≤ n → ∃ p : ℕ, Primes.Prime p ∧ Odd p ∧ n < p ∧ p ≤ 2 * n\n\nend Lax242665.OddPrimeBetween\n",
      "statements": [
        {
          "id": "Lax242665.OddPrimeBetween.exists_odd_prime_between",
          "signature": "exists_odd_prime_between : ∀ (n : Nat),\n  instLENat.le 2 n →\n    Exists fun p =>\n      And (Lax242665.Primes.Prime p) (And (Odd p) (And (instLTNat.lt n p) (instLENat.le p (instHMul.hMul 2 n))))",
          "startLine": 15,
          "endLine": 17,
          "doc": "For every `n ≥ 2` there is an odd prime `p` with `n < p ≤ 2n`."
        }
      ]
    },
    {
      "id": "Lax242665.OddPrimes",
      "path": "concepts/Lax242665/OddPrimes.lean",
      "title": "Every prime other than 2 is odd",
      "type": "lemma",
      "description": "Every prime number $p \\neq 2$ is odd.",
      "imports": [
        "Lax242665.Primes"
      ],
      "mathlibImports": [
        "Mathlib.Algebra.Ring.Parity"
      ],
      "sourceText": "import Mathlib.Algebra.Ring.Parity\nimport Lax242665.Primes\n\n/-!\n---\ntitle: Every prime other than 2 is odd\ntype: lemma\n---\nEvery prime number $p \\neq 2$ is odd.\n-/\n\nnamespace Lax242665.OddPrimes\n\n/-- A prime `p` other than `2` is odd. -/\naxiom odd_of_prime : ∀ p : ℕ, Primes.Prime p → p ≠ 2 → Odd p\n\nend Lax242665.OddPrimes\n",
      "statements": [
        {
          "id": "Lax242665.OddPrimes.odd_of_prime",
          "signature": "odd_of_prime : ∀ (p : Nat), Lax242665.Primes.Prime p → Ne p 2 → Odd p",
          "startLine": 14,
          "endLine": 15,
          "doc": "A prime `p` other than `2` is odd."
        }
      ]
    },
    {
      "id": "Lax242665.Primes",
      "path": "concepts/Lax242665/Primes.lean",
      "title": "Prime numbers",
      "type": "definition",
      "description": "A natural number greater than 1 is *prime* if it is divisible only by 1 and\nby itself.",
      "imports": [],
      "mathlibImports": [
        "Mathlib.Data.Nat.Notation"
      ],
      "sourceText": "import Mathlib.Data.Nat.Notation\n\n/-!\n---\ntitle: Prime numbers\ntype: definition\n---\nA natural number greater than 1 is *prime* if it is divisible only by 1 and\nby itself.\n-/\n\nnamespace Lax242665.Primes\n\n/-- `n` is prime: it is greater than 1, and every divisor `d` of `n` is\n`1` or `n` itself. -/\ndef Prime (n : ℕ) : Prop :=\n  1 < n ∧ ∀ d : ℕ, d ∣ n → d = 1 ∨ d = n\n\nend Lax242665.Primes\n",
      "statements": []
    }
  ],
  "proofs": [
    {
      "id": "Lax242665Proofs.InfinitelyManyPrimes.exists_prime_gt",
      "path": "proofs/Lax242665Proofs/InfinitelyManyPrimes.lean",
      "conclusion": "Lax242665.InfinitelyManyPrimes.exists_prime_gt",
      "assumptions": [],
      "description": "Euclid's argument: the smallest prime factor `p` of `n! + 1` cannot be at\nmost `n`, because then `p` would divide `n!` and hence divide `1`."
    },
    {
      "id": "Lax242665Proofs.OddPrimeBetween.exists_odd_prime_between",
      "path": "proofs/Lax242665Proofs/OddPrimeBetween.lean",
      "conclusion": "Lax242665.OddPrimeBetween.exists_odd_prime_between",
      "assumptions": [
        "Lax242665.BertrandPostulate.exists_prime_between",
        "Lax242665.OddPrimes.odd_of_prime"
      ],
      "description": "Bertrand's postulate gives a prime `p` with `n < p ≤ 2n`. Since `n ≥ 2`, this\nprime is not `2`, hence odd."
    },
    {
      "id": "Lax242665Proofs.OddPrimes.odd_of_prime",
      "path": "proofs/Lax242665Proofs/OddPrimes.lean",
      "conclusion": "Lax242665.OddPrimes.odd_of_prime",
      "assumptions": [],
      "description": "An even prime is divisible by `2`, so `2` is `1` or the prime itself."
    }
  ],
