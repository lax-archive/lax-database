  "concepts": [
    {
      "id": "Lax242665.InfinitelyManyPrimes",
      "path": "concepts/Lax242665/InfinitelyManyPrimes.lean",
      "title": "There are infinitely many primes",
      "type": "theorem",
      "description": "For every natural number $n$ there is a prime number $p > n$.",
      "imports": [
        "Lax242665.Primes"
      ],
      "mathlibImports": [],
      "sourceText": "import Lax242665.Primes\n\n/-!\n---\ntitle: There are infinitely many primes\ntype: theorem\n---\nFor every natural number $n$ there is a prime number $p > n$.\n-/\n\nnamespace Lax242665.InfinitelyManyPrimes\n\n/-- Beyond every natural number `n` lies a prime `p`. -/\naxiom exists_prime_gt : ∀ n : ℕ, ∃ p : ℕ, Primes.Prime p ∧ n < p\n\nend Lax242665.InfinitelyManyPrimes\n",
      "statements": [
        {
          "id": "Lax242665.InfinitelyManyPrimes.exists_prime_gt",
          "signature": "exists_prime_gt : ∀ (n : Nat), Exists fun p => And (Lax242665.Primes.Prime p) (instLTNat.lt n p)",
          "startLine": 13,
          "endLine": 14,
          "doc": "Beyond every natural number `n` lies a prime `p`."
        }
      ]
    },
    {
      "id": "Lax242665.PrimeDivisor",
      "path": "concepts/Lax242665/PrimeDivisor.lean",
      "title": "Every number greater than 1 has a prime divisor",
      "type": "lemma",
      "description": "Every natural number greater than $1$ has a prime divisor.",
      "imports": [
        "Lax242665.Primes"
      ],
      "mathlibImports": [],
      "sourceText": "import Lax242665.Primes\n\n/-!\n---\ntitle: Every number greater than 1 has a prime divisor\ntype: lemma\n---\nEvery natural number greater than $1$ has a prime divisor.\n-/\n\nnamespace Lax242665.PrimeDivisor\n\n/-- Every natural number `n > 1` has a prime divisor. -/\naxiom exists_prime_dvd : ∀ n : ℕ, 1 < n → ∃ p : ℕ, Primes.Prime p ∧ p ∣ n\n\nend Lax242665.PrimeDivisor\n",
      "statements": [
        {
          "id": "Lax242665.PrimeDivisor.exists_prime_dvd",
          "signature": "exists_prime_dvd : ∀ (n : Nat), instLTNat.lt 1 n → Exists fun p => And (Lax242665.Primes.Prime p) (Nat.instDvd.dvd p n)",
          "startLine": 13,
          "endLine": 14,
          "doc": "Every natural number `n > 1` has a prime divisor."
        }
      ]
    },
    {
      "id": "Lax242665.Primes",
      "path": "concepts/Lax242665/Primes.lean",
      "title": "Prime numbers",
      "type": "definition",
      "description": "A natural number greater than 1 is *prime* if it is divisible only by 1 and\nby itself.",
      "imports": [],
      "mathlibImports": [
        "Mathlib.Data.Nat.Notation"
      ],
      "sourceText": "import Mathlib.Data.Nat.Notation\n\n/-!\n---\ntitle: Prime numbers\ntype: definition\n---\nA natural number greater than 1 is *prime* if it is divisible only by 1 and\nby itself.\n-/\n\nnamespace Lax242665.Primes\n\n/-- `n` is prime: it is greater than 1, and every divisor `d` of `n` is\n`1` or `n` itself. -/\ndef Prime (n : ℕ) : Prop :=\n  1 < n ∧ ∀ d : ℕ, d ∣ n → d = 1 ∨ d = n\n\nend Lax242665.Primes\n",
      "statements": []
    },
    {
      "id": "Lax242665.TwinPrimes",
      "path": "concepts/Lax242665/TwinPrimes.lean",
      "title": "The twin prime conjecture",
      "type": "conjecture",
      "description": "For every natural number $n$ there is a prime number $p > n$ such that\n$p + 2$ is prime as well.",
      "imports": [
        "Lax242665.Primes"
      ],
      "mathlibImports": [],
      "sourceText": "import Lax242665.Primes\n\n/-!\n---\ntitle: The twin prime conjecture\ntype: conjecture\n---\nFor every natural number $n$ there is a prime number $p > n$ such that\n$p + 2$ is prime as well.\n-/\n\nnamespace Lax242665.TwinPrimes\n\n/-- Beyond every natural number `n` lies a prime `p` with `p + 2` prime as\nwell. -/\naxiom exists_twin_prime_gt :\n    ∀ n : ℕ, ∃ p : ℕ, Primes.Prime p ∧ Primes.Prime (p + 2) ∧ n < p\n\nend Lax242665.TwinPrimes\n",
      "statements": [
        {
          "id": "Lax242665.TwinPrimes.exists_twin_prime_gt",
          "signature": "exists_twin_prime_gt : ∀ (n : Nat),\n  Exists fun p => And (Lax242665.Primes.Prime p) (And (Lax242665.Primes.Prime (instHAdd.hAdd p 2)) (instLTNat.lt n p))",
          "startLine": 14,
          "endLine": 17,
          "doc": "Beyond every natural number `n` lies a prime `p` with `p + 2` prime as\nwell."
        }
      ]
    }
  ],
  "proofs": [
    {
      "id": "Lax242665Proofs.InfinitelyManyPrimes.exists_prime_gt",
      "path": "proofs/Lax242665Proofs/InfinitelyManyPrimes.lean",
      "conclusion": "Lax242665.InfinitelyManyPrimes.exists_prime_gt",
      "assumptions": [
        "Lax242665.PrimeDivisor.exists_prime_dvd"
      ],
      "description": "Euclid's argument: a prime divisor `p` of `n! + 1` cannot be at most `n`,\nbecause then `p` would divide `n!` and hence divide `1`."
    },
    {
      "id": "Lax242665Proofs.PrimeDivisor.exists_prime_dvd",
      "path": "proofs/Lax242665Proofs/PrimeDivisor.lean",
      "conclusion": "Lax242665.PrimeDivisor.exists_prime_dvd",
      "assumptions": [],
      "description": "The least divisor of `n` greater than `1` is prime and divides `n`."
    }
  ],
