      "bibEntries": [
        "@article{tovey1984simplified,\n  author  = {Tovey, Craig A.},\n  title   = {A simplified {NP}-complete satisfiability problem},\n  journal = {Discrete Applied Mathematics},\n  volume  = {8},\n  number  = {1},\n  pages   = {85--89},\n  year    = {1984},\n  doi     = {10.1016/0166-218X(84)90081-7}\n}\n"
      ]
