          "signature": "transform_sat : ∀ (F : Lax429075.CNF.Formula),\n  Iff (Lax429075.CNF.Satisfiable F) (Lax429075.CNF.Satisfiable (Lax345332.Construction.transform F))",
          "startLine": 124,
