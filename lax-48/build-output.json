        "@article{BonnetDepres2023,\n  author  = {Bonnet, {\\'E}douard and D{\\'e}pr{\\'e}s, Hugues},\n  title   = {Twin-width can be exponential in treewidth},\n  journal = {Journal of Combinatorial Theory, Series B},\n  volume  = {161},\n  pages   = {1--14},\n  year    = {2023},\n  doi     = {10.1016/j.jctb.2023.01.003}\n}\n"
