      "title": "χ-Boundedness and Neighbourhood Complexity of Bounded Merge-Width Graphs",
      "authors": [
        {
          "name": "Édouard Bonnet"
        }
      ],
      "bibEntries": [
        "@misc{bonamy2025chiboundedness,\n  title = {χ-Boundedness and Neighbourhood Complexity of Bounded Merge-Width Graphs},\n  author = {Marthe Bonamy and Colin Geniet},\n  year = {2025},\n  eprint = {2504.08266},\n  archivePrefix = {arXiv},\n  primaryClass = {math.CO},\n  doi = {10.48550/arXiv.2504.08266}\n}\n"
      ]
    },
    "abstract": "This submission formalizes two results of Marthe Bonamy and Colin Geniet:\nevery graph class of bounded merge-width is χ-bounded, and every such class\nhas linear neighbourhood complexity, Theorems 1.2 and\n1.5 of *χ-Boundedness and Neighbourhood Complexity of Bounded Merge-Width\nGraphs* (https://arxiv.org/abs/2504.08266). In particular, merge sequences, radius-$r$ merge-width,\nχ-boundedness, and neighbourhood complexity are defined in Lean.\n"
  },
  "requiredByConcepts": [],
  "requiredByProofs": [],
  "concepts": [
    {
      "id": "Lax9.BoundedMergeWidthChiBounded",
      "path": "concepts/Lax9/BoundedMergeWidthChiBounded.lean",
      "title": "χ-Boundedness of Bounded Merge-Width Classes",
      "type": "theorem",
      "description": "Every class of finite simple graphs with bounded merge-width is χ-bounded.",
      "imports": [
        "Lax9.ChiBoundedness",
        "Lax9.MergeWidth"
      ],
      "mathlibImports": [],
      "sourceText": "import Lax9.ChiBoundedness\nimport Lax9.MergeWidth\n\n/-!\n---\ntitle: χ-Boundedness of Bounded Merge-Width Classes\ntype: theorem\n---\nEvery class of finite simple graphs with bounded merge-width is χ-bounded.\n-/\n\nnamespace Lax9.BoundedMergeWidthChiBounded\n\nopen Lax9.ChiBoundedness\nopen Lax9.MergeWidth\n\n/-- Every graph class of bounded merge-width is χ-bounded. -/\naxiom bounded_mergeWidth_chiBounded\n    (C : GraphClass) (h : BoundedMergeWidth C) : ChiBounded C\n\nend Lax9.BoundedMergeWidthChiBounded\n",
      "statements": [
        {
          "id": "Lax9.BoundedMergeWidthChiBounded.bounded_mergeWidth_chiBounded",
          "signature": "bounded_mergeWidth_chiBounded : ∀ (C : Lax9.MergeWidth.GraphClass), Lax9.MergeWidth.BoundedMergeWidth C → Lax9.ChiBoundedness.ChiBounded C",
          "startLine": 17,
          "endLine": 19,
          "doc": "Every graph class of bounded merge-width is χ-bounded."
        }
