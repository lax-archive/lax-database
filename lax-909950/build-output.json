  "inputs": {
    "manifest": {
      "specVersion": "1",
      "id": "lax-909950",
      "leanVersion": "v4.33.0",
      "mathlibVersion": "db584cd6d46c92f209a44c0f1c829460d327499d",
      "title": "Planar Graphs Are 6-Colorable",
      "authors": [
        {
          "name": "Jan Dreier"
        }
      ],
      "bibEntries": [],
      "paper": {
        "folder": ".",
        "main": "main.tex",
        "engine": "pdflatex"
      }
    },
    "abstract": "We formalize the classical six color theorem: every finite planar graph admits\na proper vertex coloring with six colors. Planarity is taken to mean the\nexistence of a crossing-free straight-line drawing in the plane. The proof\nfollows the textbook route. Euler's formula $v - e + f = 2$ for connected plane\ngraphs gives the edge bound $e \\leq 3v - 6$. This bound yields a vertex of\ndegree at most $5$, and induction on the number of vertices completes the\ncoloring.\n"
  },
  "requiredByConcepts": [
    "Lax68"
  ],
  "requiredByProofs": [
    "Lax68"
  ],
  "concepts": [
    {
      "id": "Lax909950.EdgeDensity",
      "path": "concepts/Lax909950/EdgeDensity.lean",
      "title": "Planar graphs have at most 3v − 6 edges",
      "type": "theorem",
      "description": "Every finite planar graph with $v \\geq 3$ vertices has at most $3v - 6$ edges.",
      "imports": [
        "Lax68.Planar"
      ],
      "mathlibImports": [
        "Mathlib.Data.Set.Card"
      ],
      "sourceText": "import Mathlib.Data.Set.Card\nimport Lax68.Planar\n\n/-!\n---\ntitle: Planar graphs have at most 3v − 6 edges\ntype: theorem\n---\nEvery finite planar graph with $v \\geq 3$ vertices has at most $3v - 6$ edges.\n-/\n\nset_option autoImplicit false\n\nnamespace Lax909950.EdgeDensity\n\n/-- A finite planar graph with $v \\geq 3$ vertices has at most $3v - 6$ edges.\n(Since $v \\geq 3$, the natural-number subtraction does not truncate.) -/\naxiom edge_density {V : Type*} [Finite V] {G : SimpleGraph V}\n    (hG : Lax68.Planar.IsPlanar G) (hV : 3 ≤ Nat.card V) :\n  G.edgeSet.ncard ≤ 3 * Nat.card V - 6\n\nend Lax909950.EdgeDensity\n",
      "statements": [
        {
          "id": "Lax909950.EdgeDensity.edge_density",
          "signature": "edge_density : ∀ {V : Type u_1} [Finite V] {G : SimpleGraph V},\n  Lax68.Planar.IsPlanar G →\n    instLENat.le 3 (Nat.card V) → instLENat.le G.edgeSet.ncard (instHSub.hSub (instHMul.hMul 3 (Nat.card V)) 6)",
          "startLine": 16,
          "endLine": 20,
          "doc": "A finite planar graph with $v \\geq 3$ vertices has at most $3v - 6$ edges.\n(Since $v \\geq 3$, the natural-number subtraction does not truncate.)"
        }
      ]
    },
    {
      "id": "Lax909950.EulerFormula",
      "path": "concepts/Lax909950/EulerFormula.lean",
      "title": "Euler's formula",
      "type": "theorem",
      "description": "Let $G$ be a finite connected graph with a crossing-free straight-line drawing\nin the plane. The *faces* of the drawing are the connected components of the\nplane after removing all drawn points and edge segments. If the drawing has\n$v$ vertices, $e$ edges and $f$ faces, then\n$$v - e + f = 2.$$\n\nThe formula is stated as $v + f = e + 2$ in the extended natural numbers, so\nthat it also asserts that the number of faces is finite.",
      "imports": [
        "Lax68.StraightLineDrawings"
      ],
      "mathlibImports": [
        "Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected",
        "Mathlib.Data.Set.Card",
        "Mathlib.Topology.Connected.Basic",
        "Mathlib.Topology.Instances.Real.Lemmas"
      ],
      "sourceText": "import Mathlib.Data.Set.Card\nimport Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected\nimport Mathlib.Topology.Connected.Basic\nimport Mathlib.Topology.Instances.Real.Lemmas\nimport Lax68.StraightLineDrawings\n\n/-!\n---\ntitle: Euler's formula\ntype: theorem\n---\nLet $G$ be a finite connected graph with a crossing-free straight-line drawing\nin the plane. The *faces* of the drawing are the connected components of the\nplane after removing all drawn points and edge segments. If the drawing has\n$v$ vertices, $e$ edges and $f$ faces, then\n$$v - e + f = 2.$$\n\nThe formula is stated as $v + f = e + 2$ in the extended natural numbers, so\nthat it also asserts that the number of faces is finite.\n-/\n\nset_option autoImplicit false\n\nnamespace Lax909950.EulerFormula\n\nopen Lax68.StraightLineDrawings\n\n/-- The points of the plane covered by a straight-line drawing: the points of\nthe vertices together with the segments of the edges. -/\ndef image {V : Type*} {G : SimpleGraph V} (D : StraightLineDrawing G) : Set Point :=\n  Set.range D.point ∪ ⋃ (a : V) (b : V) (_ : G.Adj a b), segment ℝ (D.point a) (D.point b)\n\n/-- The faces of a straight-line drawing: the connected components of the\ncomplement of its image. -/\ndef faces {V : Type*} {G : SimpleGraph V} (D : StraightLineDrawing G) : Set (Set Point) :=\n  {F | ∃ x ∉ image D, F = connectedComponentIn (image D)ᶜ x}\n\n/-- Euler's formula: a crossing-free straight-line drawing of a finite connected\ngraph with $v$ vertices and $e$ edges has exactly $f$ faces, where\n$v + f = e + 2$. -/\naxiom euler_formula {V : Type*} [Finite V] {G : SimpleGraph V}\n    (hG : G.Connected) (D : StraightLineDrawing G) :\n  (Nat.card V : ℕ∞) + (faces D).encard = G.edgeSet.encard + 2\n\nend Lax909950.EulerFormula\n",
      "statements": [
        {
          "id": "Lax909950.EulerFormula.euler_formula",
          "signature": "euler_formula : ∀ {V : Type u_1} [Finite V] {G : SimpleGraph V},\n  G.Connected →\n    ∀ (D : Lax68.StraightLineDrawings.StraightLineDrawing G),\n      Eq (instHAdd.hAdd (Nat.card V).cast (Lax909950.EulerFormula.faces D).encard) (instHAdd.hAdd G.edgeSet.encard 2)",
          "startLine": 38,
          "endLine": 43,
          "doc": "Euler's formula: a crossing-free straight-line drawing of a finite connected\ngraph with $v$ vertices and $e$ edges has exactly $f$ faces, where\n$v + f = e + 2$."
        }
      ]
    },
    {
      "id": "Lax909950.LowDegree",
      "path": "concepts/Lax909950/LowDegree.lean",
      "title": "Planar graphs have a vertex of degree at most 5",
      "type": "theorem",
      "description": "Every finite planar graph with at least one vertex has a vertex of degree at\nmost $5$.",
      "imports": [
        "Lax68.Planar"
      ],
      "mathlibImports": [
        "Mathlib.Data.Set.Card"
      ],
      "sourceText": "import Mathlib.Data.Set.Card\nimport Lax68.Planar\n\n/-!\n---\ntitle: Planar graphs have a vertex of degree at most 5\ntype: theorem\n---\nEvery finite planar graph with at least one vertex has a vertex of degree at\nmost $5$.\n-/\n\nset_option autoImplicit false\n\nnamespace Lax909950.LowDegree\n\n/-- Every nonempty finite planar graph has a vertex with at most five\nneighbors. -/\naxiom exists_degree_le_five {V : Type*} [Finite V] [Nonempty V] {G : SimpleGraph V}\n    (hG : Lax68.Planar.IsPlanar G) :\n  ∃ x : V, (G.neighborSet x).ncard ≤ 5\n\nend Lax909950.LowDegree\n",
      "statements": [
        {
          "id": "Lax909950.LowDegree.exists_degree_le_five",
          "signature": "exists_degree_le_five : ∀ {V : Type u_1} [Finite V] [Nonempty V] {G : SimpleGraph V},\n  Lax68.Planar.IsPlanar G → Exists fun x => instLENat.le (G.neighborSet x).ncard 5",
          "startLine": 17,
          "endLine": 21,
          "doc": "Every nonempty finite planar graph has a vertex with at most five\nneighbors."
        }
      ]
    },
    {
      "id": "Lax909950.SixColoring",
      "path": "concepts/Lax909950/SixColoring.lean",
      "title": "Six color theorem",
      "type": "theorem",
      "description": "Every finite planar graph admits a proper coloring of its vertices with six\ncolors, i.e. an assignment of one of six colors to each vertex such that\nadjacent vertices receive different colors.",
      "imports": [
        "Lax68.Planar"
      ],
      "mathlibImports": [
        "Mathlib.Combinatorics.SimpleGraph.Coloring.Vertex"
      ],
      "sourceText": "import Mathlib.Combinatorics.SimpleGraph.Coloring.Vertex\nimport Lax68.Planar\n\n/-!\n---\ntitle: Six color theorem\ntype: theorem\n---\nEvery finite planar graph admits a proper coloring of its vertices with six\ncolors, i.e. an assignment of one of six colors to each vertex such that\nadjacent vertices receive different colors.\n-/\n\nset_option autoImplicit false\n\nnamespace Lax909950.SixColoring\n\n/-- Every finite planar graph is $6$-colorable. -/\naxiom six_colorable {V : Type*} [Finite V] {G : SimpleGraph V}\n    (hG : Lax68.Planar.IsPlanar G) :\n  G.Colorable 6\n\nend Lax909950.SixColoring\n",
      "statements": [
        {
          "id": "Lax909950.SixColoring.six_colorable",
          "signature": "six_colorable : ∀ {V : Type u_1} [Finite V] {G : SimpleGraph V}, Lax68.Planar.IsPlanar G → G.Colorable 6",
          "startLine": 18,
          "endLine": 21,
          "doc": "Every finite planar graph is $6$-colorable."
        }
      ]
    }
  ],
  "proofs": [
    {
      "id": "Lax909950Proofs.edge_density",
      "path": "proofs/Lax909950Proofs/EdgeDensity.lean",
      "conclusion": "Lax909950.EdgeDensity.edge_density",
      "assumptions": [
        "Lax909950.EulerFormula.euler_formula"
      ],
      "description": "For a connected graph with a cycle, every face is a side face of the edges of a\ncycle, hence of at least $3$ edges; each edge has at most $2$ side faces, so\n$3f \\leq 2e$, and Euler's formula $v - e + f = 2$ gives $e \\leq 3v - 6$. Trees have\n$v - 1 \\leq 3v - 6$ edges. Disconnected graphs split into a component and the rest,\nand the bound is superadditive."
    },
    {
      "id": "Lax909950Proofs.euler_formula",
      "path": "proofs/Lax909950Proofs/EulerFormula.lean",
      "conclusion": "Lax909950.EulerFormula.euler_formula",
      "assumptions": [],
      "description": "By induction on the number of edges. A tree has one face. Otherwise some edge lies\non a cycle; its two sides lie in different faces, and deleting it merges them."
    },
    {
      "id": "Lax909950Proofs.exists_degree_le_five",
      "path": "proofs/Lax909950Proofs/LowDegree.lean",
      "conclusion": "Lax909950.LowDegree.exists_degree_le_five",
      "assumptions": [
        "Lax909950.EdgeDensity.edge_density"
      ],
      "description": "If every vertex had degree at least $6$, the degree sum $2e$ would be at least\n$6v$, contradicting the edge density bound $e \\leq 3v - 6$. Graphs with at most\n$6$ vertices are handled directly."
    },
    {
      "id": "Lax909950Proofs.six_colorable",
      "path": "proofs/Lax909950Proofs/SixColoring.lean",
      "conclusion": "Lax909950.SixColoring.six_colorable",
      "assumptions": [
        "Lax909950.LowDegree.exists_degree_le_five"
      ],
      "description": "By induction on the number of vertices: remove a vertex of degree at most $5$,\ncolor the remaining graph, and give the removed vertex a color not used by any\nof its neighbors."
    }
  ],
