  "inputs": {
    "manifest": {
      "specVersion": "1",
      "id": "lax-523824",
      "leanVersion": "v4.33.0",
      "mathlibVersion": "db584cd6d46c92f209a44c0f1c829460d327499d",
      "title": "Exact Schrödinger kinetic split and quartic remainder bound",
      "authors": [
        {
          "name": "G. D. Partin",
          "github": "gpartin"
        }
      ],
      "bibEntries": [
        "@software{partin2026schrodinger,\n  author = {Partin, G. D.},\n  title = {LeanSchrodingerDerivation},\n  year = {2026},\n  doi = {10.5281/zenodo.24270168},\n  url = {https://github.com/gpartin/LeanSchrodingerDerivation}\n}\n"
      ]
    },
    "abstract": "For positive mass, the positive relativistic kinetic energy obtained after\nremoving rest energy is exactly the Schrödinger kinetic term plus an explicit\nnegative correction.  This submission also bounds the correction's magnitude\nby a quartic expression in momentum.  The formalization assumes the positive\nrelativistic mass shell; it does not derive that mass shell, an\narbitrary-wavefunction position-space Schrödinger equation, the Born rule, a\nphysical particle, or a complete quantum theory.\n"
  },
  "requiredByConcepts": [],
  "requiredByProofs": [],
  "concepts": [
    {
      "id": "Lax523824.SchrodingerRemainderBound",
      "path": "concepts/Lax523824/SchrodingerRemainderBound.lean",
      "title": "Exact Schrödinger kinetic split and quartic remainder bound",
      "type": "theorem",
      "description": "For positive mass, the positive relativistic kinetic energy after rest-energy\nremoval is exactly the Schrödinger kinetic term plus the explicit correction\ndefined below.  The correction's magnitude is bounded by a quartic expression\nin momentum.\n\nThe statements assume the positive relativistic mass shell encoded by\n`relativisticEnergy`.  They do not derive that mass shell, an\narbitrary-wavefunction position-space Schrödinger equation, the Born rule, a\nphysical particle, or a complete quantum theory.",
      "imports": [],
      "mathlibImports": [
        "Mathlib.Analysis.Real.Sqrt"
      ],
      "sourceText": "import Mathlib.Analysis.Real.Sqrt\n\n/-!\n---\ntitle: Exact Schrödinger kinetic split and quartic remainder bound\ntype: theorem\n---\nFor positive mass, the positive relativistic kinetic energy after rest-energy\nremoval is exactly the Schrödinger kinetic term plus the explicit correction\ndefined below.  The correction's magnitude is bounded by a quartic expression\nin momentum.\n\nThe statements assume the positive relativistic mass shell encoded by\n`relativisticEnergy`.  They do not derive that mass shell, an\narbitrary-wavefunction position-space Schrödinger equation, the Born rule, a\nphysical particle, or a complete quantum theory.\n-/\n\nnamespace Lax523824.SchrodingerRemainderBound\n\nnoncomputable section\n\ndef relativisticEnergy (mass momentum : ℝ) : ℝ :=\n  Real.sqrt (mass ^ 2 + momentum ^ 2)\n\ndef restPhaseRemovedEnergy (mass momentum : ℝ) : ℝ :=\n  relativisticEnergy mass momentum - mass\n\ndef schrodingerEnergy (mass momentum : ℝ) : ℝ :=\n  momentum ^ 2 / (2 * mass)\n\ndef schrodingerRemainder (mass momentum : ℝ) : ℝ :=\n  -(momentum ^ 4) /\n    (2 * mass * (relativisticEnergy mass momentum + mass) ^ 2)\n\naxiom exactSchrodingerKineticSplit\n    (mass momentum : ℝ) (hMass : 0 < mass) :\n    restPhaseRemovedEnergy mass momentum =\n      schrodingerEnergy mass momentum + schrodingerRemainder mass momentum\n\naxiom schrodingerRemainderBound\n    (mass momentum : ℝ) (hMass : 0 < mass) :\n    |schrodingerRemainder mass momentum| ≤ momentum ^ 4 / (8 * mass ^ 3)\n\nend\nend Lax523824.SchrodingerRemainderBound\n",
      "statements": [
        {
          "id": "Lax523824.SchrodingerRemainderBound.exactSchrodingerKineticSplit",
          "signature": "exactSchrodingerKineticSplit : ∀ (mass momentum : Real),\n  Real.instLT.lt 0 mass →\n    Eq (Lax523824.SchrodingerRemainderBound.restPhaseRemovedEnergy mass momentum)\n      (instHAdd.hAdd (Lax523824.SchrodingerRemainderBound.schrodingerEnergy mass momentum)\n        (Lax523824.SchrodingerRemainderBound.schrodingerRemainder mass momentum))",
          "startLine": 36,
          "endLine": 39
        },
        {
          "id": "Lax523824.SchrodingerRemainderBound.schrodingerRemainderBound",
          "signature": "schrodingerRemainderBound : ∀ (mass momentum : Real),\n  Real.instLT.lt 0 mass →\n    Real.instLE.le (abs (Lax523824.SchrodingerRemainderBound.schrodingerRemainder mass momentum))\n      (instHDiv.hDiv (instHPow.hPow momentum 4) (instHMul.hMul 8 (instHPow.hPow mass 3)))",
          "startLine": 41,
          "endLine": 43
        }
      ]
    }
  ],
  "proofs": [
    {
      "id": "Lax523824Proofs.SchrodingerRemainderBound.exactSchrodingerKineticSplit_proof",
      "path": "proofs/Lax523824Proofs/SchrodingerRemainderBound.lean",
      "conclusion": "Lax523824.SchrodingerRemainderBound.exactSchrodingerKineticSplit",
      "assumptions": [],
      "description": "Rationalizing the positive square root gives the exact kinetic energy.  A\ncommon-denominator calculation then separates its quadratic leading term from\nthe explicit correction without using a series expansion."
    },
    {
      "id": "Lax523824Proofs.SchrodingerRemainderBound.schrodingerRemainderBound_proof",
      "path": "proofs/Lax523824Proofs/SchrodingerRemainderBound.lean",
      "conclusion": "Lax523824.SchrodingerRemainderBound.schrodingerRemainderBound",
      "assumptions": [],
      "description": "The positive relativistic energy is at least the mass.  This supplies a lower\nbound on the correction's denominator and therefore the stated quartic upper\nbound on its magnitude."
    }
  ],
