  "concepts": [
    {
      "id": "Lax851268.Succ",
      "path": "concepts/Lax851268/Succ.lean",
      "title": "A number is at most its successor",
      "type": "theorem",
      "description": "For every natural number *n*, *n* is at most *n* + 1. A trivial statement\nwhose only purpose is to travel through the archive in the `v4.33.0`\nenvironment, the first admitted beside the epoch.",
      "imports": [],
      "mathlibImports": [
        "Mathlib.Order.Basic"
      ],
      "sourceText": "import Mathlib.Order.Basic\n\n/-!\n---\ntitle: A number is at most its successor\ntype: theorem\n---\nFor every natural number *n*, *n* is at most *n* + 1. A trivial statement\nwhose only purpose is to travel through the archive in the `v4.33.0`\nenvironment, the first admitted beside the epoch.\n-/\n\nnamespace Lax851268.Succ\n\n/-- a number is at most its successor -/\naxiom leSucc : ∀ n : ℕ, n ≤ n + 1\n\nend Lax851268.Succ\n",
      "statements": [
        {
          "id": "Lax851268.Succ.leSucc",
          "signature": "leSucc : ∀ (n : Nat), instLENat.le n (instHAdd.hAdd n 1)",
          "startLine": 15,
          "endLine": 16,
          "doc": "a number is at most its successor"
        }
      ]
    }
  ],
  "proofs": [
    {
      "id": "Lax851268Proofs.leSucc",
      "path": "proofs/Lax851268Proofs/Succ.lean",
      "conclusion": "Lax851268.Succ.leSucc",
      "assumptions": [],
      "description": "`Nat.le_succ`, directly."
    }
  ],
